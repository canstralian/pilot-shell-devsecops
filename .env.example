# Environment variables — copy to .env and fill in values.
# Never commit the actual .env file (it is already in .gitignore).

# Flask environment: "development" or "production"
FLASK_ENV=development

# A long, random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Database connection URL (SQLAlchemy format).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///dev.db

# Port the app listens on (Hugging Face Spaces injects this automatically).
PORT=7860
